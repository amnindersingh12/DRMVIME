{
  "manifest_version": 3,
  "name": "TwinVine URL Capturer",
  "version": "1.0",
  "description": "Automatically captures MPD and License URLs for TwinVine downloader",
  "permissions": [
    "webRequest",
    "storage",
    "clipboardWrite",
    "notifications",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://mediacdn.testbook.com/*",
    "*://india-drm.sdmc.tv/*",
    "*://*.testbook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}